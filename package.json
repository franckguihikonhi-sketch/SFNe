{
  "name": "sfne",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de lecture des factures normalisees electroniques (FNE) et de restitution en Markdown.",
  "main": "src/serveur/serveur.js",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sfne": "src/cli.js"
  },
  "scripts": {
    "start": "node src/serveur/demarrer.js",
    "test": "node --test tests/*.test.js",
    "cle": "node outils/cle.js",
    "exemple": "node src/cli.js exemples/facture-avoir.md --sortie exemples/facture-avoir.attendu.md",
    "verifier": "node scripts/verifier-service.js"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  }
}
